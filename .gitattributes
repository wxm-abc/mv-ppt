# 统一换行符：脚本必须 LF，否则 Linux/macOS 上的 shebang 会失败
* text=auto eol=lf

*.py     text eol=lf
*.cjs    text eol=lf
*.mjs    text eol=lf
*.js     text eol=lf
*.sh     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.html   text eol=lf

# 二进制资源不做转换
*.woff2  binary
*.woff   binary
*.png    binary
*.jpg    binary
*.mp4    binary
